   "end": 267.3,
   "text": "Write a message to parents about reading."
  },
  {
   "start": 267.7,
   "end": 268.74,
   "text": "Parents are busy."
  },
  {
   "start": 268.95,
   "end": 270.08,
   "text": "and we'll read it on a phone."
  },
  {
   "start": 270.49,
   "end": 272.07,
   "text": "Be warm and respectful."
  },
  {
   "start": 272.73,
   "end": 273.16,
   "text": "complaining."
  },
  {
   "start": 273.53,
   "end": 274.98,
   "text": "End with one request."
  },
  {
   "start": 275.29,
   "end": 276.84,
   "text": "10 minutes of reading a day."
  },
  {
   "start": 277.14,
   "end": 278.34,
   "text": "before you press Send."
  },
  {
   "start": 278.71,
   "end": 280.04,
   "text": "rid at once as apparent."
  },
  {
   "start": 280.38,
   "end": 283.2,
   "text": "If it sounds like a friend who cares about your child."
  },
  {
   "start": 283.61,
   "end": 284.04,
   "text": "Send it."
  }

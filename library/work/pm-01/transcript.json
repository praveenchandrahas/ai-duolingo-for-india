   "i": 51,
   "pause_after": 0.82,
   "at_pause": true
  },
  {
   "start": 182.36,
   "end": 183.94,
   "text": "after the AI writes it.",
   "pieces": 1,
   "i": 52,
   "pause_after": 0.4,
   "at_pause": true
  },
  {
   "start": 184.34,
   "end": 186.08,
   "text": "Read the message aloud once.",
   "pieces": 1,
   "i": 53,
   "pause_after": 0.34,
   "at_pause": true
  },
  {
   "start": 186.42,
   "end": 190.05,
   "text": "If you would not say a sentence to a parent's face, remove it.",
